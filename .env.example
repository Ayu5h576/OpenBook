# ============================================================
# SUPABASE CONFIGURATION (Required for Authentication)
# ============================================================

# Get these values from https://supabase.com
# Project → Settings → API → Project URL and keys

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_JWT_SECRET="your-jwt-secret-key"

# ============================================================
# GEMINI AI CONFIGURATION (Optional, for AI features)
# ============================================================

# Get your key from https://ai.google.dev
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# The URL where this app is hosted
# For local development: http://localhost:5173
# For production: https://yourdomain.com
APP_URL="http://localhost:5173"

# Environment (development, production)
NODE_ENV="development"

# API Port (backend server port)
API_PORT="3000"
