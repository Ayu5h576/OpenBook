# ============================================================
# OpenBook — environment variables
#
#   cp .env.example .env
#
# Only DATABASE_URL and JWT_SECRET are required. The server calls
# process.exit(1) at startup if either is missing — see
# src/server/config/env.ts. Everything else has a default.
# ============================================================

# ------------------------------------------------------------
# Required
# ------------------------------------------------------------

# PostgreSQL connection string (Prisma).
# On Railway: add a Postgres plugin and it injects this automatically.
# Note the app uses Prisma directly — there is no Supabase dependency.
DATABASE_URL=postgresql://user:password@localhost:5432/openbook

# Signs access tokens (HS256). Generate your own, never reuse one:
#   openssl rand -base64 32
JWT_SECRET=replace-me-with-openssl-rand-base64-32

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Port the API binds to. railway.toml sets API_PORT=3000 for deploys;
# unset, the in-process default is 5173.
API_PORT=3000

# development | production | test
NODE_ENV=development

# Public origin of the app. This is the CORS allow-origin, so it must
# match the URL the browser actually uses — set it to your real
# deployed URL in production, not localhost.
APP_URL=http://localhost:5173

# ------------------------------------------------------------
# Tokens (optional — defaults shown)
# ------------------------------------------------------------

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ------------------------------------------------------------
# Optional integrations
# ------------------------------------------------------------

# Google AI Studio (https://ai.google.dev). Without it the AI features
# serve canned offline responses rather than failing.
GEMINI_API_KEY=

# Enables the real Google Books catalog; unset falls back to mock data.
GOOGLE_BOOKS_API_KEY=

# Enables Redis-backed caching, rate limiting, and SSE fan-out across
# replicas. Without it all three fall back to per-process stores —
# fine for a single instance, but limits reset per replica.
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------

# Used by the integration tests in place of DATABASE_URL. Set this
# locally, or the auth integration suite writes real users into your
# dev database.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/openbook_test
