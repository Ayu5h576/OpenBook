# ============================================================
# DATABASE (Required)
# ============================================================

# Get these values from https://supabase.com
# Project Settings → API section

# Backend server uses these (no VITE_ prefix)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key
SUPABASE_JWT_SECRET=your-jwt-secret-key

# Frontend uses these (must have VITE_ prefix for Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

APP_URL=http://localhost:5173
NODE_ENV=development
API_PORT=3000

# ============================================================
# GEMINI AI CONFIGURATION (Optional, for AI features)
# ============================================================

# Get your key from https://ai.google.dev
# Leave empty if not using AI features
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================
# GOOGLE BOOKS API CONFIGURATION (Optional, for book catalog)
# ============================================================

# Get your key from https://console.cloud.google.com
# Enable Books API in your Google Cloud project
# Leave empty if not using real book data (will use mock data)
GOOGLE_BOOKS_API_KEY=your-google-books-api-key-here

# ============================================================
# REDIS CONFIGURATION (Optional, for distributed caching)
# ============================================================

# Leave empty to use the built-in file-based cache (default)
# Run locally with: docker run -p 6379:6379 redis:alpine
# Railway/Render add-ons will provide this URL automatically
# REDIS_URL=redis://localhost:6379
