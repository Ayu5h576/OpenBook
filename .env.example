# ============================================================
# DATABASE (Required)
# ============================================================

# Local Postgres. Create the database first, then run `npm run db:migrate`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openbook?schema=public

# ============================================================
# AUTH TOKENS (Required)
# ============================================================

# Signs access tokens. Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-secret

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

APP_URL=http://localhost:5173
NODE_ENV=development
API_PORT=3000

# ============================================================
# GEMINI AI CONFIGURATION (Optional, for AI features)
# ============================================================

# Get your key from https://ai.google.dev
# Leave empty if not using AI features
GEMINI_API_KEY=your-gemini-api-key-here
