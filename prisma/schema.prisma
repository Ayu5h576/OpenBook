// ─── Book Catalog ─────────────────────────────────────────────────────────────

model Book {
  id              String   @id @default(uuid()) @db.Uuid
  googleBooksId   String?  @unique @map("google_books_id")
  title           String
  subtitle        String?
  authors         String[] @default([])
  description     String?  @db.Text
  coverImage      String?  @map("cover_image")
  pageCount       Int?     @map("page_count")
  categories      String[] @default([])
  language        String   @default("en")
  publisher       String?
  publishedDate   String?  @map("published_date")
  isbn10          String?  @map("isbn_10")
  isbn13          String?  @map("isbn_13")
  averageRating   Decimal? @map("average_rating") @db.Decimal(3, 2)
  ratingsCount    Int      @default(0) @map("ratings_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  libraryEntries  LibraryEntry[]
  wishlistEntries WishlistEntry[]
  collectionBooks CollectionBook[]
  reviews         Review[]
  quotes          UserQuote[]

  // Phase 5: Social & Community
  bookClubs       BookClub[]
  activities      Activity[]

  @@index([title])
  @@index([authors])
  @@map("books")
}

// ─── User Library ─────────────────────────────────────────────────────────────

model LibraryEntry {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId       String        @map("book_id") @db.Uuid
  book         Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status       LibraryStatus @default(OWNED)
  currentPage  Int           @default(0) @map("current_page")
  isFavorite   Boolean       @default(false) @map("is_favorite")
  isPinned     Boolean       @default(false) @map("is_pinned")
  startedAt    DateTime?     @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?     @map("finished_at") @db.Timestamptz(6)
  lastReadAt   DateTime?     @map("last_read_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  readingSessions ReadingSession[]
  notes           BookNote[]
  highlights      BookHighlight[]

  @@unique([userId, bookId])
  @@index([userId, status])
  @@index([userId, isFavorite])
  @@map("library_entries")
}

model ReadingSession {
  id           String       @id @default(uuid()) @db.Uuid
  entryId      String       @map("entry_id") @db.Uuid
  entry        LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  startPage    Int          @map("start_page")
  endPage      Int          @map("end_page")
  durationSecs Int          @map("duration_secs")
  startedAt    DateTime     @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime     @map("ended_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entryId])
  @@map("reading_sessions")
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────

model WishlistEntry {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String           @map("book_id") @db.Uuid
  book      Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  priority  WishlistPriority @default(MEDIUM)
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, bookId])
  @@index([userId, priority])
  @@map("wishlist_entries")
}

// ─── Collections ──────────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverImage  String?  @map("cover_image")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  books CollectionBook[]

  @@index([userId])
  @@map("collections")
}

model CollectionBook {
  id           String     @id @default(uuid()) @db.Uuid
  collectionId String     @map("collection_id") @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  bookId       String     @map("book_id") @db.Uuid
  book         Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0) @map("sort_order")
  addedAt      DateTime   @default(now()) @map("added_at") @db.Timestamptz(6)

  @@unique([collectionId, bookId])
  @@index([collectionId])
  @@map("collection_books")
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String   @map("book_id") @db.Uuid
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  rating    Decimal  @db.Decimal(3, 1)
  title     String?
  body      String?  @db.Text
  isPrivate Boolean  @default(false) @map("is_private")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("reviews")
}

// ─── Notes & Highlights ───────────────────────────────────────────────────────

model BookNote {
  id      String       @id @default(uuid()) @db.Uuid
  entryId String       @map("entry_id") @db.Uuid
  entry   LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  text    String       @db.Text
  page    Int?
  chapter Int?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([entryId])
  @@map("book_notes")
}

model BookHighlight {
  id      String       @id @default(uuid()) @db.Uuid
  entryId String       @map("entry_id") @db.Uuid
  entry   LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  text    String       @db.Text
  color   String       @default("amber")
  page    Int?
  chapter Int?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entryId])
  @@map("book_highlights")
}

// ─── Quotes ───────────────────────────────────────────────────────────────────

model UserQuote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String?  @map("book_id") @db.Uuid
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  text      String   @db.Text
  page      Int?
  category  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("user_quotes")
}

// ─── Goals ────────────────────────────────────────────────────────────────────

model ReadingGoal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  targetBooks Int      @map("target_books")
  targetPages Int?     @map("target_pages")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, year])
  @@index([userId])
  @@map("reading_goals")
}

// ─── Phase 5: Social Graph ──────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @map("following_id") @db.Uuid
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// ─── Phase 5: Activity Feed ─────────────────────────────────────────────────────

model Activity {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ActivityType
  bookId       String?      @map("book_id") @db.Uuid
  book         Book?        @relation(fields: [bookId], references: [id], onDelete: SetNull)
  // Denormalized display payload (usernames, titles, club names) so the feed
  // renders without extra joins and survives deletion of the referenced entity.
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("activities")
}

// ─── Phase 5: Book Clubs ────────────────────────────────────────────────────────

model BookClub {
  id            String           @id @default(uuid()) @db.Uuid
  ownerId       String           @map("owner_id") @db.Uuid
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  coverImage    String?          @map("cover_image")
  currentBookId String?          @map("current_book_id") @db.Uuid
  currentBook   Book?            @relation(fields: [currentBookId], references: [id], onDelete: SetNull)
  isPrivate     Boolean          @default(false) @map("is_private")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  members     BookClubMember[]
  discussions Discussion[]

  @@index([ownerId])
  @@map("book_clubs")
}

model BookClubMember {
  id       String   @id @default(uuid()) @db.Uuid
  clubId   String   @map("club_id") @db.Uuid
  club     BookClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id") @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
  @@map("book_club_members")
}

// ─── Phase 5: Discussions & Comments ────────────────────────────────────────────

model Discussion {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  club      BookClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  comments DiscussionComment[]

  @@index([clubId, createdAt])
  @@map("discussions")
}

model DiscussionComment {
  id           String     @id @default(uuid()) @db.Uuid
  discussionId String     @map("discussion_id") @db.Uuid
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  body         String     @db.Text
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([discussionId, createdAt])
  @@map("discussion_comments")
}

// ─── Phase 5: Achievements ──────────────────────────────────────────────────────

// Achievement definitions live in code (achievementService catalog); only a
// user's unlocks are persisted so the unlock date stays stable once earned.
model UserAchievement {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String   @map("achievement_key")
  unlockedAt     DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(6)

  @@unique([userId, achievementKey])
  @@index([userId])
  @@map("user_achievements")
}
